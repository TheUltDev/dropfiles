# Supabase project URL (Dashboard → Project Settings → API)
# Project ref: zperyjgrxiqbzepsyckz
EXPO_PUBLIC_SUPABASE_URL=https://zperyjgrxiqbzepsyckz.supabase.co

# Supabase publishable key (Dashboard → Project Settings → API → Publishable key)
# Works for PostgREST and the uploads Edge Function (JWT verification disabled; owner token auth in-function).
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Storage bucket name (default: drops)
EXPO_PUBLIC_BUCKET=drops

# Edge Function base URL for native S3 multipart uploads
EXPO_PUBLIC_UPLOADS_FUNCTION_URL=https://zperyjgrxiqbzepsyckz.supabase.co/functions/v1/uploads
